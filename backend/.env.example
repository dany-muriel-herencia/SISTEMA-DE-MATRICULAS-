# ==============================================================================
# SISTEMA DE MATRICULA UNJBG - VARIABLES DE ENTORNO (EJEMPLO)
# ==============================================================================
# Copie este archivo como .env y ajuste los valores para su entorno local.
# NO almacenar credenciales de producción en este archivo.

# Configuración del Servidor
PORT=3000
NODE_ENV=development
API_PREFIX=/api/v1

# Configuración de Base de Datos Local (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_matricula_unjbg
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0

# Configuración de Autenticación y Seguridad
JWT_SECRET=tu_clave_secreta_super_segura_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=8h
CORS_ORIGIN=*
